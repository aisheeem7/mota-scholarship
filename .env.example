# ------------------------------------------------------------
# TRISETU environment template
#
# Backend:  copy the backend block to services/api/.env
# Frontend: copy the frontend block to apps/web/.env.local
# Never commit real values. Both target files are git-ignored.
# ------------------------------------------------------------

# ---------- Backend (services/api/.env) ----------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Document OCR (LlamaCloud / LlamaParse)
LLAMA_CLOUD_API_KEY=

# Structured extraction provider: "mock" (deterministic, no credits)
# or "gpt4o" (live, requires OPENAI_API_KEY)
EXTRACTION_PROVIDER=mock
OPENAI_API_KEY=

# ---------- Frontend (apps/web/.env.local) ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_STUDENT_ID=<seeded-demo-student-uuid>
